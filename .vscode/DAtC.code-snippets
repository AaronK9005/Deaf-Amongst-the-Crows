	"new game_state header": {
		"scope": "c,c++",
		"prefix": "ngsth",
		"body": [
				"#ifndef DAtC_${1/(.*)/${1:/upcase}/}_STATE_H",
				"#define DAtC_${1/(.*)/${1:/upcase}/}_STATE_H",
				"",
				"typedef struct game_state_t game_state_t;",
				"",
				"extern const game_state_t* ${1/(.*)/${1:/downcase}/}_state;",
				"",
				"#endif // DAtC_${1/(.*)/${1:/upcase}/}_STATE_H"
			],				
		"description": "Creates boilerplate for new game_state header file"
	},
	"new game_state source": {
		"scope": "c,c++",
		"prefix": "ngstc",
		"body": [
			"#include \"states/game_state.h\"",
			"#include \"states/${1/(.*)/${1:/downcase}/}_state.h\"",
			"#include \"game.h\"",
			"\n$0\n",
			"void ${1/(.*)/${1:/downcase}/}_state_enter(game_t* game)",
			"{\n\t(void)game;\n}\n\n",
			"void ${1/(.*)/${1:/downcase}/}_state_update(game_t* game)",
			"{\n\t(void)game;\n}\n\n",
			"void ${1/(.*)/${1:/downcase}/}_state_render(game_t* game)",
			"{\n\t(void)game;\n}\n\n",
			"void ${1/(.*)/${1:/downcase}/}_state_exit(game_t* game)",
			"{\n\t(void)game;\n}\n\n",
			"const game_state_t _${1/(.*)/${1:/downcase}/}_state = {",
			"\t.enter = ${1/(.*)/${1:/downcase}/}_state_enter,",
			"\t.update = ${1/(.*)/${1:/downcase}/}_state_update,",
			"\t.render = ${1/(.*)/${1:/downcase}/}_state_render,",
			"\t.exit = ${1/(.*)/${1:/downcase}/}_state_exit",
			"};\n\n",
			"const game_state_t* ${1/(.*)/${1:/downcase}/}_state = &_${1/(.*)/${1:/downcase}/}_state;",
			"\n\n"
		],
		"description": "Creates boilerplate for new game_state source file"
	}
}
